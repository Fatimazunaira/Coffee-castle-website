# Copy this file to ".env" and fill in the values. Never commit ".env".

# Port the server listens on
PORT=5000

# Secret used to sign login tokens. Use a long random text, for example the
# output of:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The first admin account (created automatically if no admin exists yet)
ADMIN_EMAIL=admin@coffeecastle.pk
ADMIN_PASSWORD=

# MongoDB Atlas connection string (or a local MongoDB connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
